<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- "Draw over other apps" — what actually lets the camera feed render on top of the TV's own
         live broadcast without switching away from it. On some Android TV boxes there's no
         Settings UI toggle for this at all; see the setup notes — it's granted via
         `adb shell appops set <pkg> SYSTEM_ALERT_WINDOW allow` instead. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- This app only ever talks to a user-configured local Home Assistant instance (WebSocket
         handshake + the HLS stream it hands back) — on a typical home network that's plain
         http/ws, not https/wss, and Android blocks cleartext traffic by default for apps
         targeting API 28+. Whole-app cleartext is fine here since there's nothing else this app
         ever connects to. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.TvCamOverlay"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">

        <!-- Not the primary way this app gets used day to day (that's the broadcast receivers
             below) — exists so the app is visible/launchable on the TV home screen at all, to
             confirm install and to check/open the overlay permission from the TV itself. -->
        <activity
            android:name=".config.SetupActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".overlay.CameraOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- No standard foreground-service type (mediaPlayback/camera/dataSync/...) actually
                 describes "draw a persistent system-overlay window" — mediaPlayback in particular
                 implies user-controlled playback, which this passive HA-triggered overlay isn't.
                 specialUse + a declared subtype is the Android 14+-correct choice. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="camera_overlay_display" />
        </service>

        <!-- Always running (see KeepAliveService's kdoc) — keeps the app's process alive/"recently
             used" between triggers instead of getting fully evicted, so SHOW/HIDE keep responding
             instantly. -->
        <service
            android:name=".overlay.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="camera_overlay_keep_alive" />
        </service>

        <!-- Exported deliberately — the entry point for Home Assistant's adb_command integration,
             same trust model as the tv module's own PlaybackReceiver. -->
        <receiver
            android:name=".overlay.CameraOverlayReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.pestpoint.radioauto.tvcam.action.SHOW_CAMERA" />
                <action android:name="com.pestpoint.radioauto.tvcam.action.HIDE_CAMERA" />
            </intent-filter>
        </receiver>

        <!-- One-time device setup (HA base URL + long-lived access token) via adb, without
             needing to open the Setup activity by hand. -->
        <receiver
            android:name=".config.ConfigReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.pestpoint.radioauto.tvcam.action.CONFIGURE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".overlay.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
